# general
DOMAIN=localhost
APP_DATA_DIR=./app-data
ENVIRONMENT=development
# CHANGE ME (required): a long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start (DEBUG off) until this is a real value.
SECRET_KEY=CHANGE_ME
# CHANGE ME if not the real domains; space- or comma-separated, e.g.
#   example.org *.example.org   (*.example.org = all subdomains, same as .example.org)
# Defaults to turtlestitch.org / backface.net and their subdomains when left as CHANGE_ME.
ALLOWED_HOSTS=CHANGE_ME

# postgres
POSTGRES_HOST=db
POSTGRES_DB=turtle
POSTGRES_USER=turtle
POSTGRES_PASSWORD=CHANGE_ME

# legacydb: DEPRECATED, marked for removal (only for the disabled apps.legacydb)
# LEGACYDB_HOST=legacy-db
# LEGACYDB_DB=turtle
# LEGACYDB_USER=turtle
# LEGACYDB_PASSWORD=CHANGE_ME

# emails
EMAIL_HOST="mail.your-server.de"
EMAIL_HOST_USER="you"
EMAIL_HOST_PASSWORD="your-passwrod"
EMAIL_FROM="You <your@email.com>"
EMAIL_PORT=587

# sentry
SENTRY_DSN=

# tuning
PORT=8000
TIMEOUT=300
NUM_WORKERS=3